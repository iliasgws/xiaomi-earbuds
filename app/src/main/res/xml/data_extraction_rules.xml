<?xml version="1.0" encoding="utf-8"?>
<!--
   Disable cloud backup and device-to-device transfer.
   allowBackup=false is the primary switch; this file covers Android 12+ transfers.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
